diff --git a/models/model_motcat.py b/models/model_motcat.py
new file mode 100644
index 0000000..0905aef
--- /dev/null
+++ b/models/model_motcat.py
@@ -0,0 +1,25 @@
+"""Compatibility wrapper around the official MOTCat model."""
+
+from importlib.util import module_from_spec, spec_from_file_location
+from pathlib import Path
+
+import torch
+
+
+_source = (
+    Path(__file__).resolve().parents[2]
+    / "MOTCat"
+    / "models"
+    / "model_motcat.py"
+)
+_spec = spec_from_file_location("_official_motcat_model", _source)
+_module = module_from_spec(_spec)
+_spec.loader.exec_module(_module)
+
+
+class MCATPathwaysMotCat(_module.MOTCAT_Surv):
+    def forward(self, **kwargs):
+        hazards, _, _, _ = super().forward(**kwargs)
+        return torch.logit(
+            hazards.clamp(min=1e-7, max=1 - 1e-7)
+        )
